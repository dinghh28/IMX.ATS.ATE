<Window x:Class="IMX.ATS.Manual.CanInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:IMX.ATS.Manual" 
             d:DataContext="{d:DesignInstance Type=local:CanInfoViewModel}"
             mc:Ignorable="d" WindowStyle="None"   BorderThickness="1"
             ResizeMode="NoResize" Focusable="False"
              x:Name="Win"
             Height="400" Width="600">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <converter:EnumDescriptionConverter x:Key="EnumValue"/>
                    <converter:RadioBtConvter x:Key="RadioBtConvter"/>
                </ResourceDictionary>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.DataContext>
        <Binding Path="CanInfo" Source="{StaticResource Locator}"/>
    </Window.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoaded}" CommandParameter="{Binding ElementName=Win}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid  >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0.5 0.5 0">
            <Button Content="&#xe71f;" 
                    Style="{StaticResource ControlButtonStyle}" 
                    Command="{Binding WindowClose}" CommandParameter="{Binding ElementName=Win}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="仲裁波特率" VerticalAlignment="Center" HorizontalAlignment="Center"  />
            <ComboBox Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding  BaudRate}" HorizontalAlignment="Center" IsReadOnly="True" Width="130"/>
            <Label Grid.Column="2" Content="数据域波特率" VerticalAlignment="Center" HorizontalAlignment="Center"  />
            <ComboBox Grid.Column="3" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding  DataBaudRate}"  HorizontalAlignment="Center" IsReadOnly="True" Width="130"/>
            <!--<Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="仲裁波特率" VerticalAlignment="Center" HorizontalAlignment="Right"  />
                <ComboBox Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding  BaudRate}" IsReadOnly="True" Width="120"/>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="数据域波特率" VerticalAlignment="Center" HorizontalAlignment="Right"  />
                <ComboBox Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding  DataBaudRate}" IsReadOnly="True" Width="120"/>
            </Grid>-->
        </Grid>
        <Grid Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="DBC配置" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0"/>
            <TextBox Grid.Column="1" 
                     IsReadOnly="True"
                     Text="{Binding DBCConfigName}"
                     VerticalAlignment="Center"  VerticalContentAlignment="Center"  HorizontalAlignment="Left"
                     MinLines="2"  Width="180"/>
            <Button Grid.Column="2" Content="选择配置" Command="{Binding ChangeDBC}" Width="80" Height="35" Margin="40,0,0,0"/>
        </Grid>
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="Black" Width="500">
            <Grid>
                <ListBox ItemsSource="{Binding Messagestrs}" >

                </ListBox>
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="初始化CAN设备" 
                    Width="100" Height="35"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Command="{Binding CanInit}"/>
            <Button Content="卸载CAN设备" Margin="20 0 0 0"
          Width="100" Height="35"
          VerticalAlignment="Center" HorizontalAlignment="Center"
          Command="{Binding CanUnInit}"/>
        </StackPanel>
    </Grid>
</Window>
