<UserControl x:Class="IMX.ATS.DBCConfig.DBCConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMX.ATS.DBCConfig" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework"
             xmlns:viewmodel="clr-namespace:IMX.ATS.DBCConfig"
             xmlns:electricity="clr-namespace:IMX.ATE.Common;assembly=IMX.ATE.Common"
             d:DataContext="{d:DesignInstance Type=viewmodel:DBCConfigViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             x:Name="Win">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
                <ResourceDictionary>
                    <converter:RadioBtConvter x:Key="RadioBtConvter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <Binding Path="DBCConfig" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoaded}" CommandParameter="{Binding ElementName=Win}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="DBC配置名称:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{Binding DBCConfigName}" MinWidth="200" VerticalAlignment="Center" HorizontalAlignment="Left" IsReadOnly="{Binding EnableEditName}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="DBC配置说明:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            
            <TextBox Grid.Column="1" Text="{Binding DBCConfigDescription}"
                     BorderBrush="Black"
                     VerticalAlignment="Center" HorizontalAlignment="Left"
                     MinWidth="200"
                     VerticalContentAlignment="Top"
                     TextWrapping="Wrap" MinLines="5">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="当前配置选择DBC文件:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            <Grid Grid.Column="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding DBCFileName}"
                             BorderBrush="Black"
                             VerticalAlignment="Center" HorizontalAlignment="Left"
                             Width="400"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap" MinLines="4"
                             IsReadOnly="True">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1" Content="文件变更" Command="{Binding ChangeDBCFile}" CommandParameter="Change" Height="35" Width="100"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" IsEnabled="{Binding EnableEditElectricity}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Label Content="供电电能：" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                <RadioButton Content="单相电"
                             GroupName="electricity"
                             IsChecked="{Binding Electricity, 
                                         Mode=TwoWay, 
                                         Converter={StaticResource RadioBtConvter},
                                         ConverterParameter={x:Static electricity:Electricity.Single}}"
                             Margin="0,0,30,0"/>
                <RadioButton Content="单相电带逆变"
                 GroupName="electricity"
                 IsChecked="{Binding Electricity, 
                             Mode=TwoWay, 
                             Converter={StaticResource RadioBtConvter},
                             ConverterParameter={x:Static electricity:Electricity.SingleANDInversion}}"
                 Margin="0,0,30,0"/>
                <RadioButton Content="三相电" 
                             GroupName="electricity"
                             IsChecked="{Binding Electricity, 
                                         Mode=TwoWay, 
                                         Converter={StaticResource RadioBtConvter},
                                         ConverterParameter={x:Static electricity:Electricity.Three}}"
                             Margin="0,0,30,0"/>
                
                <RadioButton Content="三相电带逆变" 
                             GroupName="electricity"
                             IsChecked="{Binding Electricity, 
                                         Mode=TwoWay, 
                                         Converter={StaticResource RadioBtConvter},
                                         ConverterParameter={x:Static electricity:Electricity.ThreeANDInversion}}"/>
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="保存配置信息" Command="{Binding Save}"  Height="35"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
