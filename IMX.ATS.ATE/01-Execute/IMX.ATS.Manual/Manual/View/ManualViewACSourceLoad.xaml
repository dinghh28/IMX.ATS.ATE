<UserControl x:Class="IMX.ATS.Manual.ManualViewACSourceLoad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:operatmode="clr-namespace:IMX.Device.Common.Enumerations;assembly=IMX.Device.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMX.ATS.Manual" 
             xmlns:localconverter="clr-namespace:IMX.ATS.Manual.Convter"
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework"
             d:DataContext="{d:DesignInstance Type=local:ManualViewModelACSourceLoad}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <Binding Path="ACSourceLoad" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
                <ResourceDictionary>
                    <converter:EnumDescriptionConverter x:Key="EnumValue"/>
                    <converter:RadioBtConvter x:Key="RadioBtConvter"/>
                    <localconverter:ACSourceLoadConverter x:Key="LocalConvter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <GroupBox Header="交流源载一体机">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="95"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="01-运行状态"  >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="设置运行状态："  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1"  Margin="5,0" Height="35"  Width="200"  ItemsSource="{Binding OperateTypeList, Converter={StaticResource EnumValue}}" SelectedValue="{Binding OperateType, Converter={StaticResource EnumValue}}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                        <!--<GroupBox Grid.Column="0" Header="01-设备选择">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="当前操作设备："  VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"  Margin="5,0" Height="35" Width="200" VerticalContentAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding DeviceAdress}" SelectedValue="{Binding SelectedAddress}"/>
                            </Grid>
                        </GroupBox>-->
                        <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="参  数  下  发" Margin="0,0,20,0" Height="40" Width="100" Command="{Binding SetValues}"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <GroupBox Grid.Column="1" Header="02-系统参数设置">
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <WrapPanel Margin="0,0,20,0">
                                    <Label Content="源载模式:"/>
                                    <RadioButton Content="电源"  VerticalAlignment="Center" GroupName="mode" 
                                                 IsChecked="{Binding DeviceMode, Mode=TwoWay, Converter={StaticResource RadioBtConvter}, ConverterParameter={x:Static operatmode:DeviceOperatMode.VOLT}}"/>
                                    <RadioButton Content="负载"   VerticalAlignment="Center"   GroupName="mode"
                                                 IsChecked="{Binding DeviceMode,  Mode=TwoWay,  Converter={StaticResource RadioBtConvter}, ConverterParameter={x:Static operatmode:DeviceOperatMode.LOAD}}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Label Content="相线模式"/>
                                    <RadioButton Content="单相"  VerticalAlignment="Center"  GroupName="phase" 
                                                 IsChecked="{Binding PhaseMode, Mode=TwoWay, Converter={StaticResource RadioBtConvter},ConverterParameter={x:Static operatmode:Phase_Mode.ONE}}"/>
                                    <RadioButton Content="三相" VerticalAlignment="Center" GroupName="phase"
                                                 IsChecked="{Binding PhaseMode,  Mode=TwoWay,  Converter={StaticResource RadioBtConvter}, ConverterParameter={x:Static operatmode:Phase_Mode.THREE}}"/>
                                </WrapPanel>

                                <CheckBox  Margin="30,0,0,0" Content="平衡模式"  VerticalAlignment="Center"
                                           IsEnabled="{Binding PhaseMode,Converter={StaticResource LocalConvter},ConverterParameter='PHASEMODE'}" IsChecked="{Binding Balance, Mode=TwoWay}"/>

                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="03-参数设置" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <!--<ColumnDefinition/>-->
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!--<CheckBox Content="步进模式" VerticalAlignment="Center" 
                       IsChecked="{Binding Set_StepModel,Mode=TwoWay}" 
                       IsEnabled="{Binding Balance}"/>-->

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="开机相角值:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding OpenAngle}" VerticalAlignment="Center"/>
                                    <Label Grid.Column="2" Content="°" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="停机相角值:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding CloseAngle}" VerticalAlignment="Center"/>
                                    <Label Grid.Column="2" Content="°" VerticalAlignment="Center"/>
                                </Grid>

                            </Grid>
                            <!--#region 电源模式参数-->
                            <Grid Grid.Column="1" Visibility="{Binding DeviceMode, Converter={StaticResource LocalConvter}, ConverterParameter='VOLT'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <!--<GroupBox Header="相位角设置">-->
                                    <Grid  Grid.Row="0" 
                        IsEnabled="{Binding Balance, Converter={StaticResource LocalConvter},ConverterParameter='Balance'}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="AUTO"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="AB相位角:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding PhaseControl_AB}" VerticalAlignment="Center"/>
                                            <Label Grid.Column="2" Content="°" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="AUTO"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="AC相位角:" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding PhaseControl_AC}" VerticalAlignment="Center"/>
                                            <Label Grid.Column="2" Content="°" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                    <!--</GroupBox>-->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="输出频率:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding OutputFrequency}" VerticalAlignment="Center"/>
                                        <Label Grid.Column="2" Content="Hz" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="频率斜率:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding OutputFrequencySlope}" VerticalAlignment="Center"/>
                                        <Label Grid.Column="2" Content="Hz/ms" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <UniformGrid Grid.Column="1" Rows="1">
                                    <GroupBox Header="A相" >
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="电压值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue_A}" VerticalAlignment="Center" IsEnabled="{Binding EnableSetValue}"/>
                                                <Label Grid.Column="2" Content="Vac" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="电压斜率" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding VolSlope_A}" VerticalAlignment="Center"/>
                                                <Label Grid.Column="2" Content="V/ms" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="B相" 
                           Visibility="{Binding Balance, Converter={StaticResource LocalConvter}, ConverterParameter='Balance'}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="电压值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue_B}" VerticalAlignment="Center"/>
                                                <Label Grid.Column="2" Content="Vac" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="电压斜率" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding VolSlope_B}" VerticalAlignment="Center"/>
                                                <Label Grid.Column="2" Content="V/ms" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="C相"
                           Visibility="{Binding Balance, Converter={StaticResource LocalConvter}, ConverterParameter='Balance'}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="电压值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue_C}" VerticalAlignment="Center"/>
                                                <Label Grid.Column="2" Content="Vac" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="电压斜率" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding VolSlope_C}" VerticalAlignment="Center"/>
                                                <Label Grid.Column="2" Content="V/ms" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <!--<GroupBox Header="步进参数" 
                           Visibility="{Binding Balance, Converter={StaticResource LocalConvter}, ConverterParameter='Step'}"
                           IsEnabled="{Binding EnableSetStepValue}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="起始值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding StartLoadValue}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="结束值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding EndLoadValue}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="步幅:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding Stride}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="步频:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding StepFrequency}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>-->
                                </UniformGrid>
                            </Grid>

                            <!--#endregion-->

                            <!--#region 负载模式参数-->
                            <Grid Grid.Column="1" Visibility="{Binding DeviceMode, Converter={StaticResource LocalConvter}, ConverterParameter='LOAD'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Content="负载模式：" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Row="1" VerticalAlignment="Top">
                                            <RadioButton Content="CC" GroupName="loadmode" Margin="0,0,5,0"
                                      IsChecked="{Binding OpaerateMode, 
                                      Mode=TwoWay, 
                                      Converter={StaticResource RadioBtConvter},
                                      ConverterParameter={x:Static operatmode:Opaerate_Mode.CC}}"/>
                                            <RadioButton Content="CR" GroupName="loadmode" Margin="0,0,5,0"
                                      IsChecked="{Binding OpaerateMode, 
                                      Mode=TwoWay, 
                                      Converter={StaticResource RadioBtConvter},
                                      ConverterParameter={x:Static operatmode:Opaerate_Mode.CR}}"/>
                                            <RadioButton Content="CP" GroupName="loadmode" Margin="0,0,5,0"
                                      IsChecked="{Binding OpaerateMode, 
                                      Mode=TwoWay, 
                                      Converter={StaticResource RadioBtConvter},
                                      ConverterParameter={x:Static operatmode:Opaerate_Mode.CP}}"/>
                                        </WrapPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" IsEnabled="{Binding Balance, Converter={StaticResource LocalConvter},ConverterParameter='Balance'}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Content="缺项功能：" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Row="1" VerticalAlignment="Top">
                                            <CheckBox Content="B相" Margin="0,0,20,0" IsChecked="{Binding PhaseLoss_B,Mode=TwoWay}"/>
                                            <CheckBox Content="C相" IsChecked="{Binding PhaseLoss_C, Mode=TwoWay}"/>
                                        </WrapPanel>
                                    </Grid>
                                </Grid>

                                <UniformGrid Grid.Column="1" Rows="1">
                                    <GroupBox Header="A相">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="2*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="拉载值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue_A}" VerticalAlignment="Center" IsEnabled="{Binding EnableSetValue}"/>
                                                <Label Grid.Column="2" Content="{Binding OpaerateMode, Converter={StaticResource LocalConvter}, ConverterParameter='OpaerateMode'}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Visibility="{Binding OpaerateMode, Converter={StaticResource LocalConvter}, ConverterParameter='CR'}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Content="电流斜率" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CurSlope_A}" VerticalAlignment="Center"/>
                                                    <Label Grid.Column="2" Content="A/ms" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Content="功率因素" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding PowerFactor_A}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="B相"
                           Visibility="{Binding Balance, Converter={StaticResource LocalConvter}, ConverterParameter='BALANCE'}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="2*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="拉载值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue_B}" VerticalAlignment="Center"/>
                                                <Label Grid.Column="2" Content="{Binding OpaerateMode, Converter={StaticResource LocalConvter}, ConverterParameter='OpaerateMode'}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Visibility="{Binding OpaerateMode, Converter={StaticResource LocalConvter}, ConverterParameter='CR'}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Content="电流斜率" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CurSlope_B}" VerticalAlignment="Center"/>
                                                    <Label Grid.Column="2" Content="A/ms" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Content="功率因素" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding PowerFactor_B}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="C相"
                           Visibility="{Binding Balance, Converter={StaticResource LocalConvter}, ConverterParameter='BALANCE'}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition Height="2*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="拉载值:" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue_C}" VerticalAlignment="Center"/>
                                                <Label Grid.Column="2" Content="{Binding OpaerateMode, Converter={StaticResource LocalConvter}, ConverterParameter='OpaerateMode'}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Visibility="{Binding OpaerateMode, Converter={StaticResource LocalConvter}, ConverterParameter='CR'}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Content="电流斜率" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CurSlope_C}" VerticalAlignment="Center"/>
                                                    <Label Grid.Column="2" Content="A/ms" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Content="功率因素" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding PowerFactor_C}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

