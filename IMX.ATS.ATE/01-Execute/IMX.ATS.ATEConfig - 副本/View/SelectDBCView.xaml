<Window x:Class="IMX.ATS.ATEConfig.SelectDBCView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMX.ATS.ATEConfig" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
        d:DataContext="{d:DesignInstance Type=local:SelectDBCViewModel}"
        mc:Ignorable="d"
        Title="SelectDBC" Height="500" Width="450"    
        FontFamily="Microsoft YaHei" FontWeight="ExtraLight" Foreground="#333"
        WindowStyle="None" AllowsTransparency="True"  WindowStartupLocation="CenterScreen" Background="#FFF6F7FC"
        ResizeMode="NoResize"  x:Name="Win">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <Binding Path="SelectDBC" Source="{StaticResource Locator}"/>
    </Window.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoaded}" CommandParameter="{Binding ElementName=Win}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Border BorderThickness="0.5" BorderBrush="Gray"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="Black"/>
            <Grid Grid.Row="0" Margin="10,5">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                    <Label Content="DBC配置选择" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                    <Label Content="" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0"  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0.5 0.5 0">
                    <Button Content="&#xe71f;" 
                        Style="{StaticResource ControlButtonStyle}" 
                        Command="{Binding WindowClose}" CommandParameter="{Binding ElementName=Win}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="10,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <Label Content="DBC配置信息检索："/>
                    <TextBox MinWidth="240" 
                             ToolTip="请输入DBC配置说明"
                             Text="{Binding SearchStr,UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource SearchTextBoxStyle}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="TextChanged">
                                <i:InvokeCommandAction Command="{Binding Search}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </WrapPanel>
                <Grid Grid.Row="1">
                    <DataGrid CanUserAddRows="False" 
              CanUserSortColumns="False" 
              CanUserDeleteRows="False" 
              IsReadOnly="True" 
              AutoGenerateColumns="False" 
              ScrollViewer.VerticalScrollBarVisibility="Auto" 
              SelectionMode="Single"
              AlternationCount="2" 
              AlternatingRowBackground="LightCyan"
              SelectedIndex="{Binding SelectedIndex}"
              ItemsSource="{Binding SearchDBCConfigInfos}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="配置名称" IsReadOnly="True" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Label Content="{Binding Config.ConfigName}" ToolTip="{Binding Config.Describe}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--<DataGridTextColumn Header="配置名称" IsReadOnly="True" Binding="{Binding Config.ConfigName}" Width="*"/>-->
                            <DataGridTextColumn Header="创建时间" IsReadOnly="True" Binding="{Binding Config.CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="120"/>
                            <DataGridTemplateColumn Header="DBC文件名称" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Config.DBCFileName}" TextWrapping="WrapWithOverflow" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="选择当前配置" Command="{Binding Submit}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
