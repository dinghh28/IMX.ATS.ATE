<UserControl x:Class="IMX.ATS.DBCConfig.CustomConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMX.ATS.DBCConfig"
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework"
             xmlns:resuoce="clr-namespace:IMX.ATS.DBCConfig.Resuoce"
             xmlns:vehiclebus="clr-namespace:Piggy.VehicleBus.Common;assembly=Piggy.VehicleBus.Common"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             d:DataContext="{d:DesignInstance Type=local:CustomConfigViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             x:Name="Win">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>

                <ResourceDictionary>
                    <converter:RadioBtConvter x:Key="RadioBtConvter"/>
                    <resuoce:CustomConfigEnableConverter x:Key="CustomConfigEnable"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <UserControl.DataContext>
        <Binding Path="Custom" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoaded}" CommandParameter="{Binding ElementName=Win}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Grid Margin="10,0,10,0">
            <WrapPanel VerticalAlignment="Center" >
                <Label Content="自定义下发消息配置名称:"/>
                <ComboBox Width="180" ItemsSource="{Binding CustomConfigs}" 
                          SelectedValuePath="ConfigName" 
                          DisplayMemberPath="ConfigName"  
                          SelectedIndex="{Binding  SelectedConfigIndex,Delay=10, Mode=TwoWay}"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="保存当前配置" Height="40" Width="80" 
                        Command="{Binding Save}"
                        IsEnabled="{Binding CustomConfigs.Count, Converter={ StaticResource CustomConfigEnable}}"/>
                <Button Content="新建配置" Height="40" Width="80" 
                        Margin="20,0,0,0"
                        Command="{Binding Insert}"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="自定义消息配置"
                  IsEnabled="{Binding CustomConfigs.Count, Converter={ StaticResource CustomConfigEnable}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5">
                    <Button Content="添加自定义消息" Margin="0,0,20,0" Height="25" Width="150" Command="{Binding AddMessage, Delay=10}"/>
                    <Button Content="删除当前选中自定义消息" Height="25" Width="150" Command="{Binding DeletMessage}"/>
                </WrapPanel>
                <ListBox Grid.Row="1" Margin="5,5,5,0" 
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ItemsSource="{Binding CustomMessages}"
                         SelectedIndex="{Binding SelectedMessageIndex}"
                         d:ItemsSource="{d:SampleData ItemCount=5}" >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="4" BorderBrush="Black" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="帧ID"/>
                                                <TextBox Grid.Column="1" Width="120" Text="{Binding MessageID, Mode=TwoWay, StringFormat={}{0:X2}}" InputMethod.IsInputMethodEnabled="False"/>
                                            </Grid>
                                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="报文发送格式"/>
                                                <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding FrameFormats}" SelectedIndex="{Binding SelectedFrameFormat}"/>
                                                <!--<WrapPanel Grid.Column="1">
                    <RadioButton Content="CAN 标准帧" IsChecked="{Binding FrameFormat, 
                                            Mode=TwoWay, 
                                            Converter={StaticResource RadioBtConvter},
                                            ConverterParameter={x:Static vehiclebus:FrameFormat.StandardCAN}}"/>
                    <RadioButton Content="CAN 扩展帧" IsChecked="{Binding FrameFormat, 
                                            Mode=TwoWay, 
                                            Converter={StaticResource RadioBtConvter},
                                            ConverterParameter={x:Static vehiclebus:FrameFormat.ExtendedCAN}}"/>
                    <RadioButton Content="CAN FD 标准帧" IsChecked="{Binding FrameFormat, 
                                            Mode=TwoWay, 
                                            Converter={StaticResource RadioBtConvter},
                                            ConverterParameter={x:Static vehiclebus:FrameFormat.StandardCANFD}}"/>
                    <RadioButton Content="CAN FD 扩展帧" IsChecked="{Binding FrameFormat, 
                                            Mode=TwoWay, 
                                            Converter={StaticResource RadioBtConvter},
                                            ConverterParameter={x:Static vehiclebus:FrameFormat.ExtendedCANFD}}"/>
                </WrapPanel>-->
                                            </Grid>
                                            <Grid Grid.Column="2" Margin="10,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="发送周期"/>
                                                <TextBox Grid.Column="1" Width="60" Text="{Binding CycleTime, Mode=TwoWay}"/>
                                                <Label Grid.Column="2" Content="毫秒" HorizontalAlignment="Left"/>
                                            </Grid>
                                            <Grid Grid.Column="3" Margin="10,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="发送次数"/>
                                                <TextBox Grid.Column="1" Width="60" Text="{Binding SendCount, Mode=TwoWay}"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="下发数据"/>
                                        <TextBox Grid.Column="1" Text="{Binding Data, Mode=TwoWay, StringFormat={}{0:X2}}" InputMethod.IsInputMethodEnabled="False"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>
       
    </Grid>
</UserControl>
