<UserControl x:Class="IMX.ATS.DBCConfig.DBCSendConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMX.ATS.DBCConfig" 
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework"
             xmlns:vehiclebus="clr-namespace:Piggy.VehicleBus.Common;assembly=Piggy.VehicleBus.Common"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             d:DataContext="{d:DesignInstance Type=local:DBCSendConfigViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             x:Name="Win">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>

                <ResourceDictionary>
                    <converter:RadioBtConvter x:Key="RadioBtConvter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <HierarchicalDataTemplate x:Key="message"
                DataType="{x:Type local:SendSignalConfig}" 
                ItemsSource="{Binding Signals}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Content="{Binding Info}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="发送周期" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding CycleTime}" Width="80"/>
                        <Label Content="毫秒"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="报文发送格式" Margin="0,0,5,0"/>
                        <RadioButton Content="CAN 标准帧" IsChecked="{Binding FrameFormat, 
                                                                        Mode=TwoWay, 
                                                                        Converter={StaticResource RadioBtConvter},
                                                                        ConverterParameter={x:Static vehiclebus:FrameFormat.StandardCAN}}"/>
                        <RadioButton Content="CAN 扩展帧" IsChecked="{Binding FrameFormat, 
                                                                        Mode=TwoWay, 
                                                                        Converter={StaticResource RadioBtConvter},
                                                                        ConverterParameter={x:Static vehiclebus:FrameFormat.ExtendedCAN}}"/>
                        <RadioButton Content="CAN FD 标准帧" IsChecked="{Binding FrameFormat, 
                                                                        Mode=TwoWay, 
                                                                        Converter={StaticResource RadioBtConvter},
                                                                        ConverterParameter={x:Static vehiclebus:FrameFormat.StandardCANFD}}"/>
                        <RadioButton Content="CAN FD 扩展帧" IsChecked="{Binding FrameFormat, 
                                                                        Mode=TwoWay, 
                                                                        Converter={StaticResource RadioBtConvter},
                                                                        ConverterParameter={x:Static vehiclebus:FrameFormat.ExtendedCANFD}}"/>
                    </WrapPanel>
                    <!--<Label Grid.Row="0" Content="{Binding MessageID, StringFormat=0X{0:X}}"/>
                    <Label Grid.Row="1" Content="{Binding MessageName}"/>-->
                </Grid>
            </HierarchicalDataTemplate>
            <HierarchicalDataTemplate DataType="{x:Type local:SignalConfig}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{Binding Signal_Name}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SignalValue}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                </Grid>
                
            </HierarchicalDataTemplate>
        </ResourceDictionary>
        
        
    </UserControl.Resources>

    <UserControl.DataContext>
        <Binding Path="Send" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoaded}" CommandParameter="{Binding ElementName=Win}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!--#region 信号列表树-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <GroupBox Header="信号列表" Grid.Row="0">
                <TreeView ItemsSource="{Binding DBCMessages}" 
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  x:Name="dbcmessage">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="False"/>
                            <Setter Property="IsSelected" Value="{Binding Path=IsSelected}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#33000000"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22000000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:DBCMessageTreeNode}" ItemsSource="{Binding Signals}">
                            <StackPanel>
                                <Label Content="{Binding Name}" FontSize="14" Background="{Binding BackColor}" ToolTip="{Binding ToolTipText}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding SelectSignal}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </Label>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>

            <WrapPanel Grid.Row="1">
                <Label Content="当前选择信号:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Label Content="{Binding SelectedSignalInfo}" VerticalAlignment="Center"/>
            </WrapPanel>
        </Grid>
        <!--#endregion-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="下发配置">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <TreeView Grid.Column="0"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            ItemsSource="{Binding SendSignalConfigs}"
                            VirtualizingPanel.IsVirtualizing="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding  Signals}" DataType="{x:Type local:SendSignalConfig}">
                                    <Border BorderThickness="0,1,0,0" BorderBrush="Black">
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="{Binding Info}" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>

                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35,0,0,0">
                                                <Label Content="发送周期" Margin="0,0,5,0"/>
                                                <TextBox Text="{Binding CycleTime}" Width="80"/>
                                                <Label Content="毫秒"/>
                                            </WrapPanel>

                                            <WrapPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35,0,0,0">
                                                <Label Content="报文发送格式" Margin="0,0,5,0"/>
                                                <RadioButton Content="CAN 标准帧" IsChecked="{Binding FrameFormat, 
                    Mode=TwoWay, 
                    Converter={StaticResource RadioBtConvter},
                    ConverterParameter={x:Static vehiclebus:FrameFormat.StandardCAN}}"
                    VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
                                                <RadioButton Content="CAN 扩展帧" IsChecked="{Binding FrameFormat, 
                    Mode=TwoWay, 
                    Converter={StaticResource RadioBtConvter},
                    ConverterParameter={x:Static vehiclebus:FrameFormat.ExtendedCAN}}"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
                                                <RadioButton Content="CAN FD 标准帧" IsChecked="{Binding FrameFormat, 
                    Mode=TwoWay, 
                    Converter={StaticResource RadioBtConvter},
                    ConverterParameter={x:Static vehiclebus:FrameFormat.StandardCANFD}}"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
                                                <RadioButton Content="CAN FD 扩展帧" IsChecked="{Binding FrameFormat, 
                    Mode=TwoWay, 
                    Converter={StaticResource RadioBtConvter},
                    ConverterParameter={x:Static vehiclebus:FrameFormat.ExtendedCANFD}}"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type local:SignalConfig}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="{Binding Signal_Name}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <WrapPanel Grid.Column="1">
                                                    <Label Content="初始值:" Margin="0,0,5,0"/>
                                                    <TextBox Text="{Binding SignalValue}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="120"/>
                                                </WrapPanel>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsSelected" Value="{Binding Path=IsSelected}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#33000000"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22000000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <Button Grid.Column="1" Content="删&#x0a;除&#x0a;信&#x0a;号&#x0a;" Command="{Binding DeletSignal}"/>
                    </Grid>
                    
                </GroupBox>
                <GroupBox Grid.Row="1" Header="信号绑定">
                    <ListView
                        ItemsSource="{Binding FixedSignalConfigs}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="系统变量" Width="200" DisplayMemberBinding="{Binding SysteamName}"/>
                                <GridViewColumn Header="绑定信号" Width="350">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox 
                                                  IsReadOnly="True"
                                                  ItemsSource="{Binding Signals}"
                                                  SelectedValue="{Binding SelectedSignalValue,Mode=TwoWay}"
                                                  SelectedValuePath="Signal_Name"
                                                  DisplayMemberPath="Signal_Name"
                                                  Width="250"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>

                    </ListView>
                        <!--<DataGrid  AutoGenerateColumns="False"  
                               CanUserAddRows="False" CanUserDeleteRows="False" 
                               CanUserReorderColumns="False" CanUserSortColumns="False"
                               CanUserResizeRows="False" CanUserResizeColumns="False"
                               FontSize="14"
                               ScrollViewer.VerticalScrollBarVisibility="Visible"
                               ItemsSource="{Binding FixedSignalConfigs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="系统变量" IsReadOnly="True" Width="200" Binding="{Binding SysteamName}"/>
                            <DataGridTemplateColumn Header="绑定信号" Width="*">
                                
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox 
                                                  IsReadOnly="True"
                                                  SelectedIndex="{Binding SelectedSignalIndex,Delay=5, Mode=TwoWay}"
                                                  SelectedValuePath="Signal_Name"
                                                  SelectedValue="{Binding SelectedSignalValue,Delay=5, Mode=TwoWay}"
                                                  DisplayMemberPath="Signal_Name"
                                                  ItemsSource="{Binding Signals}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>-->
                </GroupBox>
            </Grid>
            <Grid Grid.Row="1" Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="保存下发信号配置" Command="{Binding SaveConfig}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
