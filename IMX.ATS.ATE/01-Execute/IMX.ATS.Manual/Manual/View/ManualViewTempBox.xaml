<UserControl x:Class="IMX.ATS.Manual.ManualViewTempBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMX.ATS.Manual" 
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework"
             d:DataContext="{d:DesignInstance Type=local:ManualViewModelTempBox}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <Binding Path="TempBox" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
                <ResourceDictionary>
                    <converter:EnumDescriptionConverter x:Key="EnumValue"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <GroupBox Header="温箱">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="95"/>
                        <!--<RowDefinition Height="80"/>-->
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="01-运行状态"  >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="设置运行状态："  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1"  Margin="5,0" Height="35"  Width="200"  ItemsSource="{Binding OperateTypeList, Converter={StaticResource EnumValue}}" SelectedValue="{Binding OperateType, Converter={StaticResource EnumValue}}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                        <!--<GroupBox Grid.Column="0" Header="01-设备选择">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="当前操作设备："  VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"  Margin="5,0" Height="35" Width="200" VerticalContentAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding DeviceAdress}" SelectedValue="{Binding SelectedAddress}"/>
                            </Grid>
                        </GroupBox>-->
                        <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="参  数  下  发" Margin="0,0,20,0" Height="40"  Width="100" Command="{Binding SetValues}"/>
                    </Grid>
                    <!--<Grid Grid.Row="1">
                        <GroupBox Header="02-输出模式" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="设置输出模式："  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Margin="5,0"  Height="35" Width="200"  ItemsSource="{Binding RunModeList, Converter={StaticResource EnumValue}}" SelectedValue="{Binding RunModeType, Converter={StaticResource EnumValue}}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                    </Grid>-->

                    <GroupBox Header="02-参数设置" Grid.Row="1" Margin="5">
                        <!--<ListBox Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding HVDCSourceSetValues}" d:ItemsSource="{d:SampleData ItemCount=1}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>-->
                        <!--<GroupBox  Height="60" VerticalAlignment="Top">-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <!--<RowDefinition/>-->
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="温度：" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Height="30" Width="80" Text="{Binding Set_Temperature}" HorizontalAlignment="Left"/>
                                    <Label Grid.Column="2" Content="℃"  VerticalAlignment="Center"  HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="温度斜率：" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Height="30" Width="80" Text="{Binding Set_TempSlope}" HorizontalAlignment="Left"/>
                                    <Label Grid.Column="2" Content="℃/min"  VerticalAlignment="Center"  HorizontalAlignment="Left"/>

                                </Grid>

                                <Grid Grid.Column="0" Grid.Row="1" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="湿度：" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Height="30" Width="80" Text="{Binding Set_Humidity}" HorizontalAlignment="Left"/>
                                    <Label Grid.Column="2" Content="%"  VerticalAlignment="Center"  HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Grid.Column="1" Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="湿度斜率：" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Height="30" Width="80" Text="{Binding Set_HumidSlope}" HorizontalAlignment="Left"/>
                                    <Label Grid.Column="2" Content="%/min"  VerticalAlignment="Center"  HorizontalAlignment="Left"/>

                                </Grid>
                            </Grid>
                            <!--<WrapPanel Grid.Row="2" VerticalAlignment="Center" Margin="20,0,0,0">
        <Label  Content="定时操作：" VerticalAlignment="Center"  Margin="-1,0,0,0"/>
        <TextBox Height="30" Width="80"  Text="{Binding TempBoxTestHour}" Margin="1,0,0,0"/>
        <Label  Content="H"  VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox Height="30" Width="80" Text="{Binding TempBoxTestMin}" Margin="15,0,0,0"/>
        <Label  Content="M"  VerticalAlignment="Center" Margin="0,0,5,0"/>
    </WrapPanel>-->
                        </Grid>
                        <!--</GroupBox>-->
                        <!--</DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>-->
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
