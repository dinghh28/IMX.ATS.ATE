<UserControl x:Class="IMX.ATS.Manual.ManualViewWaterBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMX.ATS.Manual" 
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework"
             d:DataContext="{d:DesignInstance Type=local:ManualViewModelWaterBox}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <Binding Path="WaterBox" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
                <ResourceDictionary>
                    <converter:EnumDescriptionConverter x:Key="EnumValue"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <GroupBox Header="直流源手动操作">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="01-设备选择">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="当前操作设备："  VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"  Margin="5,0" Height="35" Width="200" VerticalContentAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding DeviceAdress}" SelectedValue="{Binding SelectedAddress}"/>
                        </Grid>
                    </GroupBox>
                    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="参  数  下  发" Margin="0,0,20,0" Height="40" Command="{Binding SetValues}"/>
                </Grid>

                <GroupBox Header="02-运行状态" Grid.Row="1" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="设置运行状态："  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ComboBox Grid.Column="1"  Height="35" Width="200"  ItemsSource="{Binding OperateTypeList, Converter={StaticResource EnumValue}}" SelectedValue="{Binding OperateType, Converter={StaticResource EnumValue}}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        </ComboBox>
                    </Grid>
                </GroupBox>
                <GroupBox Header="03-参数设置" Grid.Row="2" Margin="5">
                    <Grid>
                        <ListBox Grid.Row="1" Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding WaterBoxSetValues}" d:ItemsSource="{d:SampleData ItemCount=3}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Grid.Row="1" Header="{Binding Channel}" Height="60">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Margin="0,0,40,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="温度：" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue.Set_Temperature, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                            </Grid>
                                            <Grid Grid.Column="1" Margin="0,0,40,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="温度速率：" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue.Set_TemperatureSlope, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                            </Grid>
                                            <Grid Grid.Column="2" Margin="40,0,20,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="流量：" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue.Set_Flow, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                            </Grid>
                                            <Grid Grid.Column="3" Margin="40,0,20,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Content="压力：" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding SetValue.Set_Pressure, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
