<UserControl x:Class="IMX.ATS.Manual.ManualViewLVDCLoad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IMX.ATS.Manual"
             xmlns:stateconverter="clr-namespace:IMX.ATE.Converts;assembly=IMX.ATE.Converts" 
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework"
             d:DataContext="{d:DesignInstance Type=local:ManualViewLVDCLoad}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <Binding  Path="LVDCLoad" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
                <ResourceDictionary>
                    <converter:EnumDescriptionConverter x:Key="EnumValue"/>
                </ResourceDictionary>
                <ResourceDictionary>
                    <stateconverter:ShortSatetConverter x:Key="State"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <GroupBox Header="低压直流负载">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="95"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="01-运行状态"  >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="设置运行状态："  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1"  Margin="5,0" Height="35"  Width="200"  ItemsSource="{Binding OperateTypeList, Converter={StaticResource EnumValue}}" 
                              SelectedValue="{Binding OperateType, Converter={StaticResource EnumValue}}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <CheckBox Content="短路模式"  IsChecked="{Binding Set_ShortState,Mode=TwoWay,Converter={StaticResource State}}"/>
                        </Grid>
                        <!--<GroupBox Grid.Column="0" Header="01-设备选择">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="当前操作设备："  VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"  Margin="5,0" Height="35" Width="200" VerticalContentAlignment="Center" HorizontalAlignment="Left" ItemsSource="{Binding DeviceAdress}" SelectedValue="{Binding SelectedAddress}"/>
                </Grid>
            </GroupBox>-->
                        <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Content="参  数  下  发" Margin="0,0,20,0" Height="40"  Width="100" Command="{Binding SetValues}"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <GroupBox Header="02-输出模式" Visibility="{Binding EnableSetLoadValue}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="设置输出模式："  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Margin="5,0"  Height="35" Width="200"  ItemsSource="{Binding RunModeList, Converter={StaticResource EnumValue}}"
                              SelectedValue="{Binding RunModeType, Converter={StaticResource EnumValue}}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <GroupBox Header="03-参数设置" Grid.Row="2" Margin="5" Visibility="{Binding EnableSetLoadValue}" >
                        <!--<ListBox Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding DCLoadSetValues}" d:ItemsSource="{d:SampleData ItemCount=1}">
                <ListBox.ItemTemplate>
                    <DataTemplate>-->
                        <GroupBox  Height="120" VerticalAlignment="Top">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,40,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="拉载值：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Set_LoadValue, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                        <Label Content="{Binding LoadUnit}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                    </Grid>
                                    <!--<Grid Grid.Column="1" Margin="0,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Von/limit：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Set_UpLimValue, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                        <Label Content="{Binding UpLimitUnit}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                    </Grid>-->
                                    <Grid Grid.Column="1" Margin="0,0,20,0" Visibility="{Binding EnableILimit}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="限制值：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Set_LimValue, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                        <Label Content="{Binding LoadUnit}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Visibility="{Binding EnableSlope}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="上升斜率：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Set_RiseSploeValue, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30" Margin="20 0 0 0"/>
                                        <Label Content="A/ms" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="0,0,20,0" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="下降斜率：" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Set_DownSploeValue, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="30"/>
                                        <Label Content="A/ms" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <!--</DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>-->
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
