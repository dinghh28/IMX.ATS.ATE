<UserControl x:Class="IMX.ATS.DIOS.TestProjectItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:local="clr-namespace:IMX.ATS.DIOS" 
             xmlns:viewmodels="clr-namespace:IMX.ATS.DIOS" 
             d:DataContext="{d:DesignInstance Type=viewmodels:TestProjectItemViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" x:Name="Win">
    <UserControl.DataContext>
        <Binding Path="Project" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoaded}" CommandParameter="{Binding ElementName=Win}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <GroupBox Header="项目信息">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="5">
                    <Label Content="开始时间" />
                    <DatePicker Margin="10,0,0,0" Text="{Binding TestStartTime, Mode=TwoWay,StringFormat=yyyy/MM/dd}"/>
                    <Label Content="结束时间" Margin="20,0,0,0" />
                    <DatePicker Margin="10,0,0,0" Text="{Binding TestEndTime, Mode=TwoWay,StringFormat=yyyy/MM/dd}"/>
                    <Label Content="项目编号" Margin="20,0,0,0"/>
                    <ComboBox Margin="10,0,0,0" Width="150"
                              SelectedIndex="{Binding Product_TestSNIndex, Mode=TwoWay}" 
                              ItemsSource="{Binding Product_Tests}"/>
                    <Label Content="产品编号" Margin="20,0,0,0"/>
                    <TextBox Margin="10,0,0,0" Width="150" Text="{Binding Product_SN}"/>
                    <Button Content="查询" Width="80" Margin="50,0,0,0" Command="{Binding Search}"/>
                </WrapPanel>
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          CanUserDeleteRows="False"
                          ItemsSource="{Binding Datas}"
                          SelectedIndex="{Binding SelectIndex}"
                          SelectionUnit="FullRow">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding Return}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="项目编号" Binding="{Binding ProjectSN}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName}" IsReadOnly="True"/>

                        <DataGridTextColumn Header="产品编号" Binding="{Binding ProductSN}" IsReadOnly="True"/>

                        <DataGridTextColumn Header="数据记录时间" Binding="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2" Margin="5">
                    <Label Content="总数:"/>
                    <Label Content="{Binding DataCount}"/>
                    <Label Content="当前页行数:" Margin="5 0 0 0"/>
                    <Label Content="{Binding ItemCount}" />
                    <Label Content="当前页/总页数:" Margin="5 0 0 0"/>
                    <Label Content="{Binding SelectPage}" Margin="5 0 0 0"/>
                    <Label Content="/"/>
                    <Label Content="{Binding PageCount}"/>
                </WrapPanel>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="5" VerticalAlignment="Center">
                    <Button Content="第一页" BorderThickness="0" Background="Transparent" Command="{Binding SelectNextDataCommand}" CommandParameter="第一页"/>
                    <Button Content="上一页" Margin="5 0 0 0" BorderThickness="0" Background="Transparent" Command="{Binding SelectNextDataCommand}" CommandParameter="上一页"/>
                    <Button Content="下一页" Margin="5 0 0 0" BorderThickness="0" Background="Transparent" Command="{Binding SelectNextDataCommand}" CommandParameter="下一页"/>
                    <Button Content="最后一页" Margin="5 0 0 0" BorderThickness="0" Background="Transparent" Command="{Binding SelectNextDataCommand}" CommandParameter="最后一页"/>
                </WrapPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
