<UserControl x:Class="IMX.ATS.DIOS.TestItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:converter="clr-namespace:H.WPF.Framework.Converters;assembly=H.WPF.Framework" 
             xmlns:localconverter ="clr-namespace:IMX.ATS.DIOS.Resource.Converter"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:testresult ="clr-namespace:IMX.Common;assembly=IMX.Common"
             xmlns:local="clr-namespace:IMX.ATS.DIOS" 
             xmlns:viewmodels="clr-namespace:IMX.ATS.DIOS" 
             d:DataContext="{d:DesignInstance Type=viewmodels:TestItemViewModel}"
             mc:Ignorable="d" x:Name="Win"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <Binding Path="TestItem" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoaded}" CommandParameter="{Binding ElementName=Win}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <converter:EnumDescriptionConverter x:Key="EnumValue"/>
                    <localconverter:ResultConverter x:Key="IconConverter"/>
                    <localconverter:TitckToMinConverter x:Key="TitckConverter"/>
                </ResourceDictionary>
                <ResourceDictionary Source="pack://application:,,,/IMX.WPF.Resource;component/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="datapro" ObjectType="{x:Type sys:Enum}" MethodName="GetValues">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="testresult:ResultState"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <GroupBox Header="测试项条目">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <WrapPanel Grid.Row="0" Margin="5">
                    <Label Content="测试项名称:"/>
                    <TextBox Width="200"  Margin="10,0,0,0" Text=""/>
                    <Label Content="测试结果:" Margin="20,0,0,0"/>
                    <ComboBox Width="100" Margin="10,0,0,0" 
                              ItemsSource="{Binding Source={StaticResource datapro}, Converter={StaticResource EnumValue}}"
                              SelectedIndex="{Binding ResultIndex,Mode=TwoWay}"/>
                    
                </WrapPanel>
                <StackPanel Grid.Row="0" Margin="5" 
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Content="检索" Command="{Binding Search}" Margin="20,0,0,0" Width="80" Height="30"/>
                    <Button Content="清除条件" Command="{Binding Clear}" Margin="20,0,0,0" Width="80" Height="30"/>
                    <Button Content="导出数据" Command="{Binding Export}" CommandParameter="DATA"
                            Margin="20,0,0,0" Width="80" Height="30"/>
                    <Button Content="导出报告" Command="{Binding Export}" CommandParameter="REPORT"
                            Margin="20,0,0,0" Width="80" Height="30"/>
                </StackPanel>

                <DataGrid Grid.Row="1"                         
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          CanUserDeleteRows="False"
                          ItemsSource="{Binding Datas}"
                          SelectedIndex="{Binding SelectIndex}"
                          SelectionUnit="FullRow"
                          IsReadOnly="True"
                          VerticalScrollBarVisibility="Visible">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding OpenDatas}" CommandParameter="{Binding ElementName=Win}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.Header>
                                <CheckBox  Content="全选">
                                    <!--IsChecked="{Binding DataContext.IsSelectAll,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window, AncestorLevel=1 }}">-->
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Checked">
                                            <i:InvokeCommandAction  Command="{Binding  RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGrid}},Path= DataContext.SelectAllCommand }"
                                                                    CommandParameter="C"/>
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="Unchecked">
                                            <i:InvokeCommandAction Command="{Binding  RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGrid}},Path= DataContext.SelectAllCommand }"
                                                                   CommandParameter="U"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </CheckBox>
                            </DataGridTemplateColumn.Header>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelect,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="测试项名称" IsReadOnly="True"
                                            Binding="{Binding Data.FlowName}"/>
                        <DataGridTextColumn Header="试验开始时间" IsReadOnly="True"
                                            Binding="{Binding Data.CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                        <DataGridTextColumn Header="试验结束时间" IsReadOnly="True"
                                            Binding="{Binding Data.UpdateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                        <DataGridTextColumn Header="试验实际运行时间(分钟)" IsReadOnly="True"
                                            Binding="{Binding Data.ActualRunTime,Converter={StaticResource TitckConverter}}"/>
                        <DataGridTextColumn Header="操作人员" IsReadOnly="True"
                                            Binding="{Binding Data.Operator}"/>
                        <DataGridTextColumn Header="试验结果" IsReadOnly="True"
                                            Binding="{Binding Data.Result, Converter={StaticResource IconConverter}}"/>
                        <DataGridTextColumn Header="故障信息" IsReadOnly="True"
                                            Binding="{Binding Data.ErrorInfo}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ProgressBar Grid.Row="2" Width="300" Height="20" IsIndeterminate="True" Minimum="0"  ToolTip="{Binding ProBarText}" 
                Value="{Binding ProBarValue}" Visibility="{Binding ProBarVisily}" Maximum="{Binding ProBarMaxValue}"/>
                <TextBlock  Grid.Column="2" Text="{Binding ProBarText}" Visibility="{Binding ProBarVisily}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Grid>

        </GroupBox>
    </Grid>
</UserControl>
