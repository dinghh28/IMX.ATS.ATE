                <GroupBox Header="01-CC设置" Grid.Row="0" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="CC电阻档：" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ComboBox Grid.Column="1" 
                                      IsReadOnly="True"
                                      Width="180"  Height="40" 
                                      VerticalContentAlignment="Center" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Source={StaticResource datapro}, Converter={StaticResource EnumValue}}"
                                      SelectedItem="{Binding CCRes, Converter={StaticResource EnumValue}}" />

                    </Grid>
                </GroupBox>

                <GroupBox Header="模板执行完成后延时设置" Grid.Row="2" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="延时时间：" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1"  Text="{Binding  DelayAfterRun}"  Height="35" Width="80" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
                            <Label  Grid.Column="2" Content="毫秒" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                    </Grid>
